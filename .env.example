# ============================================================
# Verizon Suite — Configuration
# ============================================================

# --- Required: Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890

# --- General ---
LOG_LEVEL=INFO

# --- Web Dashboard Port ---
PORT=5000

# --- AI Auto-Responder (Optional — templates work without keys) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Meta Webhook (Optional — for Instagram/Facebook DMs via official API) ---
META_VERIFY_TOKEN=my_smm_verify_token_123

# --- Twitter API (Optional — for DM polling via official API v2) ---
TWITTER_CONSUMER_SECRET=
